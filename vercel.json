{
  "version": 2,
  "functions": {
    "api/marketplace/**/*.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/build-apk.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/build-apk/*.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/marketplace/auth/register", "destination": "/api/marketplace/auth/register" },
    { "source": "/api/marketplace/auth/login", "destination": "/api/marketplace/auth/login" },
    { "source": "/api/marketplace/assets", "destination": "/api/marketplace/assets" },
    { "source": "/api/marketplace/assets/(.*)", "destination": "/api/marketplace/assets" },
    { "source": "/api/marketplace/games", "destination": "/api/marketplace/games" },
    { "source": "/api/marketplace/games/(.*)", "destination": "/api/marketplace/games" },
    { "source": "/api/marketplace/templates", "destination": "/api/marketplace/templates" },
    { "source": "/api/marketplace/templates/(.*)", "destination": "/api/marketplace/templates" },
    { "source": "/api/build-apk", "destination": "/api/build-apk" },
    { "source": "/api/build-apk/status", "destination": "/api/build-apk/status" },
    { "source": "/api/build-apk/download", "destination": "/api/build-apk/download" }
  ]
}
